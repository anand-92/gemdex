# Gemdex reference deploy — environment template.
#
#   cp .env.example .env && chmod 600 .env
#
# This file holds every secret in the stack. Never commit the real .env.
# Generate secrets, don't invent them:
#
#   openssl rand -hex 32
#
# Full walkthrough: docs/SELF_HOST_DEPLOY.md

# --- Secrets (generate these) ----------------------------------------------

# Bearer for the BYOI /v1 API. Full memory access, no per-user identity, no
# expiry — which is exactly why the BYOI port stays on 127.0.0.1 and the token
# never leaves the host. Shared by gemdex-server and gemdex-mcp-http.
#   openssl rand -hex 32
GEMDEX_SERVER_TOKEN=

# Postgres password. Read at container init; changing it later does NOT change
# the password in an existing volume (see SELF_HOST_DEPLOY.md).
#   openssl rand -hex 32
POSTGRES_PASSWORD=

# Google AI Studio key. The SERVER owns embedding, so clients need no key.
# Without it the stack still starts and /v1/health is green, but every
# save/recall fails at request time.
#
# It is also what makes the web manager's "Upload sessions" page work: uploaded
# chat transcripts are cleaned and digested by gemdex-server (the only container
# with this key AND the ingest pipeline AND the store), so the web manager needs
# no key of its own. Without a key those uploads answer 503.
GEMINI_API_KEY=

# --- Public identity -------------------------------------------------------

# The public https URL clients reach this deployment at, no trailing slash.
# This is the OAuth issuer AND the resource identity, so it must match exactly
# what clients use and what you registered with Google. Changing it later
# invalidates every client's stored OAuth metadata (one forced re-auth).
#   e.g. https://gemdex.example.com
GEMDEX_MCP_BASE_URL=

# --- Auth: google (default) ------------------------------------------------

# `google` = OAuth 2.1 resource server, single-user allowlist. `static` = one
# shared bearer, loopback dev ONLY — never behind a public edge.
GEMDEX_MCP_AUTH=google

# From Google Cloud console → APIs & Services → Credentials → OAuth client ID
# (Web application). ONE client serves both services; add BOTH of these to its
# authorized redirect URIs (Google matches them by exact string):
#     <GEMDEX_MCP_BASE_URL>/auth/callback          ← the MCP endpoint
#     <GEMDEX_WEB_BASE_URL>/auth/google/callback   ← the web manager
# This cannot be scripted; see packages/mcp-http/README.md for why and for the
# click-path.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# The ONE Google account allowed to use this deployment — shared by the MCP
# endpoint and the web manager. Google authenticates every Google account, so
# this is the actual authorization boundary; every other verified identity is
# rejected. No tenancy, no roles.
GEMDEX_ALLOWED_EMAIL=

# --- Web manager (gemdex-web) ----------------------------------------------

# The public https URL browsers reach the manager UI at, no trailing slash. It
# builds the OAuth redirect URI above, so it must match exactly.
#   e.g. https://gemdex.example.com  (if the edge routes / → web, /mcp → MCP)
#     or https://app.gemdex.example.com  (separate subdomain)
GEMDEX_WEB_BASE_URL=

# Signs the browser session cookie. This is a real secret: anyone who can guess
# it can forge a signed session and bypass GEMDEX_ALLOWED_EMAIL entirely.
# At least 32 chars, or the service refuses to start.
#   openssl rand -hex 32
GEMDEX_WEB_SESSION_SECRET=

# `google` = Google login, single account. `dev` = NO LOGIN AT ALL — loopback
# development only; never behind a public edge.
# GEMDEX_WEB_AUTH=google

# How long a browser session lasts before re-authentication (default 12h).
# Expiry is the only revocation mechanism a signed cookie has.
# GEMDEX_WEB_SESSION_TTL_SECONDS=43200

# --- Auth: static (alternative) --------------------------------------------

# Only read when GEMDEX_MCP_AUTH=static. Ignored (and dropped) in google mode,
# so a leftover value here cannot become a second way in.
#   openssl rand -hex 32
# GEMDEX_MCP_HTTP_TOKEN=

# --- Optional --------------------------------------------------------------

# Host ports. All publish on 127.0.0.1 only — these change the host-side port,
# not the exposure. Set GEMDEX_SERVER_PORT if 8765 is already taken by a
# BYOI-only stack on the same host.
# GEMDEX_SERVER_PORT=8765
# GEMDEX_MCP_HTTP_PORT=8766
# GEMDEX_WEB_PORT=8767

# Comma-separated browser origins allowed to call the BYOI directly. Leave empty
# unless a browser talks to /v1; deny-by-default otherwise.
# GEMDEX_SERVER_ALLOWED_ORIGINS=

# Opt-in trust-weighted recall re-ranking, off by default.
# GEMDEX_TRUST_RANKING=false
